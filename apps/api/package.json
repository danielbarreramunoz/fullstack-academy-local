{
  "name": "@academy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsc-watch --onSuccess \"node dist/main.js\" || tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "test": "node --test dist/**/*.spec.js 2>/dev/null || echo \"api: sin tests unitarios aun\"",
    "migration:run": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@academy/shared": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.4"
  }
}
